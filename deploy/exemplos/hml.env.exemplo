# Copie para hml.env (fora do repositório) e troque os valores.
# A senha do login rastru_hml é a mesma de Banco__SenhaDoLogin em banco-hml.env.
ConnectionStrings__Rastreamento=Server=sqlserver,1433;Database=Rastreamento_HML;User Id=rastru_hml;Password=troque-a-senha-do-login;TrustServerCertificate=True;Encrypt=True
# 32 bytes ou mais, por exemplo: openssl rand -base64 48
Jwt__SigningKey=troque-a-chave-de-assinatura-com-48-bytes-ou-mais
