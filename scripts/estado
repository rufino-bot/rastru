#!/usr/bin/env bash
# Estado do checkout, medido — o roteiro fixo de abertura de sessão em uma chamada só.
#
# Existe porque a regra nº 1 do ledger ("não acredite na página sem conferir o disco") custava
# seis chamadas de ferramenta toda sessão. Aqui ele custa uma, e o resultado é MEDIÇÃO, não
# registro: nada neste script lê `.superpowers/sdd/progress.md`.
#
#   bash scripts/estado          # git + docker (barato, ~2s)
#   bash scripts/estado --testes # acrescenta as suítes (caro: front ~15s, backend ~2min)
#   bash scripts/estado --json   # a mesma saída embrulhada para o hook SessionStart
#
# `ESTADO_DOCKER_TIMEOUT` (default 25s) limita cada chamada ao Docker. O hook usa um valor curto:
# quando o engine está fora, a chamada fica pendurada no named pipe, e o preço disso na ABERTURA da
# sessão é o usuário esperando na frente de um terminal parado.
#
# O que ele deliberadamente NÃO faz:
#   - não sobe o banco (`docker compose up -d`) — subir é ação, e ação com efeito colateral não
#     entra num script cujo propósito é observar;
#   - não roda as suítes por padrão, pelo tempo;
#   - não afirma nada que não mediu. Onde não sabe, escreve "não sei" — ver o bloco do Docker.

set -uo pipefail

# Resolvido ANTES do `cd`, e por isso existe: `${BASH_SOURCE[0]}` pode ser relativo ao diretorio de
# onde se chamou, e depois do `cd` ele aponta para o lugar errado. Achado na review de 2026-08-25:
# `bash estado --json` de dentro de `scripts/` falhava com `estado/estado: No such file or
# directory` — e, pior, saia com **exit 0 e JSON valido**, entao o hook injetaria a mensagem de erro
# como se fosse o estado medido. Exatamente o modo de falha que este script existe para evitar.
EU=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
cd "$(dirname "$EU")/.." || exit 1

TO=${ESTADO_DOCKER_TIMEOUT:-25}

# `--json` embrulha a saída no formato que o hook SessionStart injeta como contexto. Feito por
# re-execução em vez de um `if` por linha de saída — assim existe UM caminho de impressão, e o que
# o hook entrega é, byte a byte, o que o terminal mostra.
#
# O codificador é `node`, não `jq`: MEDIDO em 2026-08-25, `jq` não existe nesta máquina, e o
# exemplo canônico de hook depende dele. `node` é dependência real deste repositório (o front é
# Vite) — se ele sumir, o front para antes do hook.
if [ "${1:-}" = "--json" ]; then
  shift
  saida=$("$EU" "$@" 2>&1)
  printf '%s' "$saida" | node -e "
    let s = ''
    process.stdin.on('data', (d) => (s += d)).on('end', () => process.stdout.write(
      JSON.stringify({ hookSpecificOutput: { hookEventName: 'SessionStart', additionalContext: s } }),
    ))
  "
  exit 0
fi

echo "=============================================================="
echo " ESTADO MEDIDO — $(date '+%Y-%m-%d %H:%M')"
echo "=============================================================="

echo
echo "## GIT"
printf 'branch   : %s\n' "$(git rev-parse --abbrev-ref HEAD)"
printf 'HEAD     : %s\n' "$(git log --oneline -1)"

upstream=$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)
if [ -z "$upstream" ]; then
  printf 'remoto   : SEM UPSTREAM — esta branch nunca foi empurrada\n'
else
  frente=$(git rev-list --count "$upstream..HEAD" 2>/dev/null)
  atras=$(git rev-list --count "HEAD..$upstream" 2>/dev/null)
  if [ "$frente" = "0" ] && [ "$atras" = "0" ]; then
    printf 'remoto   : %s — SINCRONIZADO\n' "$upstream"
  else
    printf 'remoto   : %s — %s commit(s) à frente, %s atrás\n' "$upstream" "$frente" "$atras"
  fi
fi
printf 'main     : %s\n' "$(git log --oneline -1 main 2>/dev/null || echo '(sem main local)')"

echo
sujeira=$(git status --short)
if [ -z "$sujeira" ]; then
  echo "árvore   : LIMPA"
else
  echo "árvore suja:"
  echo "$sujeira" | sed 's/^/  /'
fi

echo
echo "## DOCKER"
# `docker ps` vazio NÃO significa "não há containers" — significa "não sei", porque com o engine
# fora o comando devolve lista vazia com exit 0. Isso já custou um diagnóstico errado (o de
# 2026-08-24, em que o banco foi declarado perdido e nada tinha se perdido). Por isso a pergunta
# "o engine responde?" vem ANTES, e é `docker version --format {{.Server.Version}}`, que só
# imprime quando há servidor do outro lado.
servidor=$(timeout "$TO" docker version --format '{{.Server.Version}}' 2>/dev/null)
if [ -z "$servidor" ]; then
  echo "engine   : NÃO RESPONDE — abra o Docker Desktop e espere mais do que parece razoável."
  echo "           Enquanto isto, listagem de container/volume não é dado: é ausência de resposta."
  echo "           NUNCA conclua daqui que o banco foi perdido, e nunca o reconstrua por isto."
else
  printf 'engine   : %s (responde)\n' "$servidor"
  linha=$(timeout "$TO" docker ps -a --filter name=tcc-sqlserver --format '{{.Names}}  {{.Status}}')
  if [ -z "$linha" ]; then
    echo "sqlserver: container NÃO EXISTE (o engine respondeu, então isto é dado, não ausência)"
    echo "           subir com: docker compose up -d"
  else
    printf 'sqlserver: %s\n' "$linha"
    case "$linha" in
      *Up*) : ;;
      *)    echo "           PARADO — subir com: docker compose up -d, e reconferir com docker ps" ;;
    esac
  fi
fi

echo
echo "## LEDGER (backup em rufino-bot/rastru-ledger, privado)"
# `.superpowers/` e um repositorio git PROPRIO — o repo do TCC o ignora (`.gitignore:6`). Ele
# guarda o unico registro de decisao, medicao e divida do projeto, e ate 2026-08-25 existia so no
# disco de uma maquina.
#
# As duas perguntas abaixo existem porque as duas formas de falha desta copia sao SILENCIOSAS:
# commit local que ninguem empurrou nao protege de nada, e um `sdd/.gitignore` recriado com `*`
# faz o repositorio parar de receber conteudo sem reclamar. Nos dois casos o sintoma so apareceria
# no dia de trocar de maquina — o unico dia em que este backup precisa funcionar.
if [ ! -d .superpowers/.git ]; then
  echo "ledger   : .superpowers/ NAO e repositorio git — o registro do projeto nao tem copia."
else
  if [ -f .superpowers/sdd/.gitignore ] && grep -qx '\*' .superpowers/sdd/.gitignore 2>/dev/null; then
    # Aspas SIMPLES: com aspas duplas, as crases em volta do nome do arquivo viram command
    # substitution e o bash tenta EXECUTAR `sdd/.gitignore`. Medido — a mensagem saiu com o nome
    # do arquivo comido e um "No such file or directory" no meio do aviso.
    echo 'ledger   : ⚠ sdd/.gitignore VOLTOU com "*" — o ledger esta sendo ignorado EM SILENCIO.'
    echo "           Apague-o: o repo do TCC ja ignora .superpowers/ inteiro, entao ele e redundante la."
  fi
  pendentes=$(git -C .superpowers status --short | wc -l)
  naoempurrados=$(git -C .superpowers rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo '?')
  if [ "$pendentes" -gt 0 ] || [ "$naoempurrados" != "0" ]; then
    printf 'ledger   : %s arquivo(s) sem commit, %s commit(s) sem push — o registro de hoje ainda\n' \
      "$pendentes" "$naoempurrados"
    echo "           so existe nesta maquina. Feche a sessao empurrando."
  else
    echo "ledger   : em dia (sem alteracao local, nada por empurrar)"
  fi
fi

if [ "${1:-}" = "--testes" ]; then
  echo
  echo "## SUÍTES (medidas agora)"
  echo "front:"
  (cd web && npm test -- --run 2>&1 | grep -E "Test Files|Tests " | sed 's/^/  /')
  echo "build do front:"
  (cd web && npm run build >/dev/null 2>&1 && echo "  limpo" || echo "  QUEBRADO — rode 'npm run build' e leia o erro")
  echo "backend (precisa do SQL Server no ar):"
  dotnet test Rastreamento.slnx 2>&1 | grep -E "^Test summary|total:|failed:" | sed 's/^/  /'
else
  echo
  echo "## SUÍTES — não medidas (rode com --testes, ou à mão)"
  echo "  cd web && npm test -- --run   # e npm run build: 'npm test' verde NÃO prova que compila"
  echo "  dotnet test Rastreamento.slnx # precisa do SQL Server no ar"
fi

echo
echo "=============================================================="
