<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rastreamento.Domain\Rastreamento.Domain.csproj" />
    <ProjectReference Include="..\Rastreamento.Application\Rastreamento.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.21.0" />
    <!-- Referência direta só para elevar o Pkcs transitivo (Microsoft.EntityFrameworkCore.SqlServer ->
         Microsoft.Data.SqlClient -> System.Configuration.ConfigurationManager), que resolve para 9.0.4 e
         cai nos advisories GHSA-846f-f764-76mx e GHSA-2fmv-rv2c-59x7 (corrigidos em 9.0.21 e 10.0.13).
         Nem o SqlClient mais recente traz um Pkcs fora da faixa afetada. Sai quando a cadeia de
         dependências do EF Core/SqlClient passar a trazer um Pkcs corrigido. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
